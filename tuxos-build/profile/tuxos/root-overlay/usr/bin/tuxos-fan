#!/bin/sh
# tuxos-fan: fan curves (SPEC system care #14) for desktop boards whose
# sensor chip lets the PC set its fans (hwmon pwm, like lm_sensors'
# fancontrol) and for laptops nbfc-linux supports. Settings > Performance
# shows them only where this works.
#   tuxos-fan status          (any user) "kind hwmon|nbfc|none", "mode M",
#                             "temp C", one "fan NAME RPM" per fan
#   tuxos-fan set MODE [CURVE]  (root, pkexec) auto | quiet | balanced | max |
#                             custom "T:P T:P ..." (°C : % points)
#   tuxos-fan run             (root, dinit tuxos-fan) every 2 s: CPU
#                             temperature -> fan speed on the curve
# "auto" hands the fans back to the board / laptop. Above 90 °C fans always
# run at full speed; if the temperature cannot be read, the board takes over.
set -u
hw="${TUXOS_HWMON:-/sys/class/hwmon}"
conf="${TUXOS_FAN_CONF:-/etc/tuxos/fan.conf}"

curve_of() {
    case "$1" in
        quiet) echo "40:0 55:25 70:45 80:70 88:100" ;;
        balanced) echo "35:20 50:35 65:55 75:80 85:100" ;;
        max) echo "0:100" ;;
        custom) sed -n 's/^curve=//p' "$conf" 2>/dev/null ;;
    esac
}
mode() { m=$(sed -n 's/^mode=//p' "$conf" 2>/dev/null); echo "${m:-auto}"; }

# controllable fans of the board (not the graphics card's: LACT does those)
pwms() {
    for d in "$hw"/hwmon*; do
        n=$(cat "$d/name" 2>/dev/null)
        case "$n" in amdgpu|nouveau|nvidia|radeon|i915|xe) continue ;; esac
        for p in "$d"/pwm[0-9]; do [ -w "$p" ] || [ -e "$p" ] && [ -e "${p}_enable" ] && echo "$p"; done
    done
}
has_nbfc() { command -v nbfc >/dev/null 2>&1 && nbfc status >/dev/null 2>&1; }
kind() { if [ -n "$(pwms)" ]; then echo hwmon; elif has_nbfc; then echo nbfc; else echo none; fi; }

# the CPU's temperature in whole °C
cpu_temp() {
    for d in "$hw"/hwmon*; do
        case "$(cat "$d/name" 2>/dev/null)" in
            k10temp|zenpower) f=$(grep -l -x -e Tctl -e Tdie "$d"/temp*_label 2>/dev/null | head -1); f=${f%_label}_input; [ -r "$f" ] || f="$d/temp1_input" ;;
            coretemp) f=$(grep -l '^Package' "$d"/temp*_label 2>/dev/null | head -1); f=${f%_label}_input; [ -r "$f" ] || f="$d/temp1_input" ;;
            *) continue ;;
        esac
        v=$(cat "$f" 2>/dev/null)
        case "$v" in ''|*[!0-9]*) return 1 ;; esac
        echo $(( v / 1000 )); return 0
    done
    return 1
}

# the curve's % at a temperature (straight lines between the points)
duty() {
    echo "$2" | tr ' ' '\n' | awk -F: -v t="$1" '
        NF == 2 { n++; T[n] = $1; P[n] = $2 }
        END {
            if (!n) { print 100; exit }
            if (t <= T[1]) { print P[1]; exit }
            for (i = 2; i <= n; i++) if (t <= T[i]) { printf "%d\n", P[i-1] + (P[i] - P[i-1]) * (t - T[i-1]) / (T[i] - T[i-1]); exit }
            print P[n] }'
}

give_back() {
    for p in $(pwms); do echo 2 > "${p}_enable" 2>/dev/null || echo 5 > "${p}_enable" 2>/dev/null; done
    has_nbfc && nbfc set -a >/dev/null 2>&1
}
apply_pct() {
    if [ "$(kind)" = hwmon ]; then
        for p in $(pwms); do echo 1 > "${p}_enable" 2>/dev/null; echo $(( $1 * 255 / 100 )) > "$p" 2>/dev/null; done
    else
        nbfc set -s "$1" >/dev/null 2>&1
    fi
}

case "${1:-}" in
    status)
        echo "kind $(kind)"; echo "mode $(mode)"
        t=$(cpu_temp) && echo "temp $t"
        for d in "$hw"/hwmon*; do for f in "$d"/fan[0-9]_input; do [ -r "$f" ] && echo "fan $(cat "$d/name")-$(basename "$f" _input) $(cat "$f")"; done; done 2>/dev/null
        [ "$(mode)" = custom ] && echo "curve $(curve_of custom)"
        exit 0 ;;
    set)
        m="${2:-}"
        case "$m" in auto|quiet|balanced|max) c="" ;;
            custom) c="${3:-}"; echo "$c" | grep -Eq '^([0-9]{1,3}:[0-9]{1,3} ?){2,8}$' || { echo "tuxos-fan: custom needs points like \"40:20 60:50 80:100\"" >&2; exit 2; } ;;
            *) echo "tuxos-fan: auto | quiet | balanced | max | custom CURVE" >&2; exit 2 ;; esac
        mkdir -p "$(dirname "$conf")"
        printf 'mode=%s\ncurve=%s\n' "$m" "$c" > "$conf"
        [ "$m" = auto ] && give_back
        exit 0 ;;
    run)
        trap 'give_back; exit 0' TERM INT
        # nothing this PC lets TuxOS control: nothing to do
        [ "$(kind)" = none ] && exit 0
        last=""
        while :; do
            m=$(mode)
            if [ "$m" = auto ] || [ "$(kind)" = none ]; then
                [ "$last" != auto ] && give_back; last=auto
            elif t=$(cpu_temp); then
                p=$(duty "$t" "$(curve_of "$m")")
                [ "$t" -ge 90 ] && p=100
                [ "$p" -gt 100 ] && p=100; [ "$p" -lt 0 ] && p=0
                apply_pct "$p"; last="$m"
            else
                [ "$last" != auto ] && give_back; last=auto
            fi
            # with the board in charge, look for a change only now and then
            if [ "$last" = auto ]; then sleep 10 & wait $!; else sleep 2 & wait $!; fi
        done ;;
    *) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac
