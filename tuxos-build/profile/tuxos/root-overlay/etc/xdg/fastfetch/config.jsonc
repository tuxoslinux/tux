// TuxOS fastfetch defaults. Copy to ~/.config/fastfetch/config.jsonc to
// customize; logo in /usr/share/tuxos/fastfetch/tux.txt ($1 body, $2 feet)
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/usr/share/tuxos/fastfetch/tux.txt",
        "color": {
            "1": "37",
            "2": "93"
        },
        "padding": {
            "top": 1,
            "right": 3
        }
    },
    "display": {
        "separator": "  ",
        // normal weight like the original ASCII Tux, not bold
        "brightColor": false,
        "key": {
            "width": 16
        },
        "color": {
            "keys": "93",
            "title": "93"
        }
    },
    // Modules without a value (a desktop in a text console, a battery on a
    // desktop PC) are left out by fastfetch
    "modules": [
        {
            "type": "title",
            "format": "Hi {user-name}!"
        },
        "separator",
        { "type": "os", "key": "OS" },
        { "type": "host", "key": "Host" },
        { "type": "kernel", "key": "Kernel" },
        { "type": "initsystem", "key": "Init system" },
        { "type": "uptime", "key": "Uptime" },
        { "type": "packages", "key": "Packages" },
        { "type": "shell", "key": "Shell" },
        { "type": "display", "key": "Display" },
        { "type": "de", "key": "Desktop" },
        { "type": "wm", "key": "Window manager" },
        { "type": "theme", "key": "Theme" },
        { "type": "icons", "key": "Icons" },
        { "type": "font", "key": "Font" },
        { "type": "cursor", "key": "Cursor" },
        { "type": "terminal", "key": "Terminal" },
        { "type": "terminalfont", "key": "Terminal font" },
        { "type": "cpu", "key": "CPU" },
        { "type": "gpu", "key": "GPU" },
        { "type": "memory", "key": "Memory" },
        { "type": "swap", "key": "Swap" },
        { "type": "disk", "key": "Disk (/)", "folders": "/" },
        { "type": "localip", "key": "Local IP" },
        { "type": "battery", "key": "Battery" },
        { "type": "locale", "key": "Locale" },
        "break",
        "colors"
    ]
}
