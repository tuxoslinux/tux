---
# TuxOS branding for the Calamares installer.
componentName:  tuxos

welcomeStyleCalamares:   false
welcomeExpandingLogo:   true

# Full screen on the COSMIC live desktop: COSMIC opens a Calamares window
# at its minimum size (1024x520), where the sidebar scrolls and hides
# "Install" and "Finish". windowSize is the size when leaving full screen.
windowExpanding:    fullscreen
windowSize: 1024px,640px
windowPlacement: free

sidebar: widget
navigation: widget

strings:
    productName:         TuxOS
    shortProductName:    TuxOS
    version:             rolling
    shortVersion:        rolling
    versionedName:       TuxOS
    shortVersionedName:  TuxOS
    bootloaderEntryName: TuxOS
    productUrl:          https://github.com/tuxoslinux/tux
    supportUrl:          https://discord.gg/jvGzaWEB77
    knownIssuesUrl:      https://github.com/tuxoslinux/tux/issues
    releaseNotesUrl:     https://github.com/tuxoslinux/tux

images:
    productBanner:       "tuxos-banner.png"
    productLogo:         "tuxos-logo.png"
    productIcon:         "tuxos-icon.png"
    productWelcome:      "tuxos-welcome.png"

style:
    SidebarBackground:        "#000000"
    SidebarText:              "#f4f6f8"
    SidebarTextCurrent:       "#000000"
    SidebarBackgroundCurrent: "#f5b800"

slideshow:               "show.qml"
slideshowAPI: 2

# Never upload installer logs anywhere.
uploadServer :
    type :    "none"
    url :     ""
    sizeLimit : -1
