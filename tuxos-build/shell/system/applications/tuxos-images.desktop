[Desktop Entry]
Type=Application
Name=Image viewer
Name[bg]=Преглед на изображения
Comment=Look at pictures, crop and draw on them
Comment[bg]=Разглеждай снимки, изрязвай и рисувай върху тях
Exec=tuxos-app images --page %u
Icon=image-viewer
Categories=Graphics;Viewer;
MimeType=image/png;image/jpeg;image/webp;image/gif;image/bmp;image/svg+xml;image/avif;image/tiff;
Keywords=picture;photo;image;viewer;crop;
StartupWMClass=tuxos-images
