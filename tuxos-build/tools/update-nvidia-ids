#!/bin/bash
# Refreshes the NVIDIA GPU lists that tuxos-drivers uses to pick a driver.
#
# Downloads the current and the 580xx legacy nvidia-utils packages from the
# Artix mirror, reads NVIDIA's own "Supported NVIDIA GPU Products" page from
# each, and writes the PCI device IDs of the GPUs each driver supports as
# "current" (the GPUs it does not list under legacy) to:
#   profile/tuxos/root-overlay/usr/share/tuxos/drivers/nvidia-current.ids
#   profile/tuxos/root-overlay/usr/share/tuxos/drivers/nvidia-580xx.ids
#
# Run it when the NVIDIA driver in the repositories moves to a new branch.
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
dest="${here}/../profile/tuxos/root-overlay/usr/share/tuxos/drivers"
mirror="${MIRROR:-https://mirrors.rit.edu/artixlinux}"
work="$(mktemp -d)"
trap 'rm -rf "${work}"' EXIT

mkdir -p "${dest}" "${work}/db"
curl -sfL "${mirror}/world/os/x86_64/world.db" | bsdtar -xf - -C "${work}/db"

fetch_ids() { # package output-file
    local desc file version
    desc=$(ls -d "${work}/db/$1"-[0-9]*/desc | head -n1)
    file=$(sed -n '/%FILENAME%/{n;p}' "${desc}")
    version=$(sed -n '/%VERSION%/{n;p}' "${desc}")
    echo "==> $1 ${version}"
    curl -sfL -o "${work}/${file}" "${mirror}/world/os/x86_64/${file}"
    bsdtar -xOf "${work}/${file}" usr/share/doc/nvidia/html/supportedchips.html > "${work}/chips.html"
    {
        printf '# PCI device IDs listed as current GPUs by NVIDIA for %s %s\n' "$1" "${version}"
        printf '# (from usr/share/doc/nvidia/html/supportedchips.html; generated by tools/update-nvidia-ids)\n'
        python3 -I - "${work}/chips.html" <<'EOF'
import re, sys
html = open(sys.argv[1], encoding='utf-8', errors='replace').read()
# everything after this sentence belongs to the legacy driver branches
current = html.split('Below are the legacy GPUs', 1)[0]
ids = set()
for row in re.findall(r'<tr[^>]*>(.*?)</tr>', current, re.S):
    cells = [re.sub(r'<[^>]+>', '', c).strip() for c in re.findall(r'<td[^>]*>(.*?)</td>', row, re.S)]
    if len(cells) >= 2:
        m = re.match(r'^([0-9A-Fa-f]{4})\b', cells[1])
        if m:
            ids.add(m.group(1).lower())
for i in sorted(ids):
    print(i)
EOF
    } > "$2"
    echo "    $(grep -vc '^#' "$2") device IDs -> $2"
}

fetch_ids nvidia-utils "${dest}/nvidia-current.ids"
fetch_ids nvidia-580xx-utils "${dest}/nvidia-580xx.ids"
